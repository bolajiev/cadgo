OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_DESIGN_MODEL=deepseek-v4.1-flash
# Optional rate limits; 0 disables them. Both default to 0.
CADGO_AGENT_RATE_LIMIT=0
CADGO_AGENT_IP_RATE_LIMIT=0
CADGO_AGENT_RATE_WINDOW_MS=3600000
CADGO_AGENT_MAX_TOKENS=24000
# Optional provider reasoning effort: low, medium or high. Empty uses the provider default.
CADGO_AGENT_REASONING_EFFORT=
# Optional web research providers. With no key, research falls back to DuckDuckGo and Wikipedia.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
# Optional preferred provider: brave, tavily, serper, duckduckgo or wikipedia.
WEB_SEARCH_PROVIDER=

# Optional durable rate limiting for multi-instance deployments.
# Vercel KV exposes KV_REST_API_URL/KV_REST_API_TOKEN with the same API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional large-document share storage.
# On Vercel: create a Blob store and set BLOB_READ_WRITE_TOKEN.
# Local next start falls back to .data/shares when not on Vercel.
BLOB_READ_WRITE_TOKEN=
CADGO_SHARE_DIR=
CADGO_SHARE_TTL_DAYS=30
CADGO_SHARE_RATE_LIMIT=0
CADGO_SHARE_RATE_WINDOW_MS=3600000
